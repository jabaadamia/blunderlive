APP_NAME=blunderlive-game
APP_ENV=development
APP_HOST=0.0.0.0
GAME_PORT=8005
CORE_PORT=8000
FRONTEND_PORT=3000
NGINX_PORT=8080
POSTGRES_PORT=5433
REDIS_PORT=6379
LOG_LEVEL=INFO

REDIS_URL=redis://redis:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
CORE_INTERNAL_BASE_URL=http://core:8000

CORE_SECRET_KEY=change-me
CORE_JWT_PRIVATE_KEY_PATH=/run/dev-jwt/private.pem
CORE_JWT_PUBLIC_KEY_PATH=/run/dev-jwt/public.pem
GAME_JWT_PUBLIC_KEY_PATH=/run/dev-jwt/public.pem
CORE_DEBUG=True
CORE_ALLOWED_HOSTS=localhost,127.0.0.1,core,nginx
CORE_DATABASE_URL=postgresql://blunderlive:blunderlive@postgres:5432/blunderlive_core
CORE_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CORE_SECURE_COOKIES=False
CORE_SECURE_SSL_REDIRECT=False
CORE_SECURE_HSTS_SECONDS=0
CORE_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
CORE_SECURE_HSTS_PRELOAD=False
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

POSTGRES_DB=blunderlive_core
POSTGRES_USER=blunderlive
POSTGRES_PASSWORD=blunderlive

NEXT_PUBLIC_CORE_API_BASE_URL=/api
NEXT_PUBLIC_GAME_API_BASE_URL=/api/game
INTERNAL_CORE_URL=http://core:8000
INTERNAL_GAME_URL=http://game:8005
